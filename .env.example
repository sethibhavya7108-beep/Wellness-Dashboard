# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit .env.local.
# In production, set these in the Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key. Safe to expose to the browser: every query
# it makes is still governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin, used to build the sign-in link in the OTP email.
# Local development: http://localhost:3000
# Production: your custom domain, e.g. https://wellness.example.org
# Leave unset on Vercel preview deployments and the preview URL is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Deliberately absent: SUPABASE_SERVICE_ROLE_KEY.
# This application never uses the service-role key. Privileged reads go through
# SECURITY DEFINER functions with explicit, narrow projections instead.
# See docs/SECURITY.md.
# ---------------------------------------------------------------------------
